<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Vidcord</title>
    <!-- Force installation to /Applications only — no location choice shown to user -->
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.cyroz1.vidcord"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.cyroz1.vidcord" visible="false">
        <pkg-ref id="com.cyroz1.vidcord"/>
    </choice>
    <pkg-ref id="com.cyroz1.vidcord" version="5.6" onConclusion="none">vidcord-component.pkg</pkg-ref>
</installer-gui-script>
