# Environment variables for vidcord development
# Copy this file to .env and fill in values as needed.
# All VITE_* variables are exposed to the frontend bundle.
# All TAURI_ENV_* variables are read by the Tauri build system.

# Uncomment to enable debug/source-map build mode:
# TAURI_ENV_DEBUG=true

# Uncomment to override the detected target platform:
# TAURI_ENV_PLATFORM=windows
