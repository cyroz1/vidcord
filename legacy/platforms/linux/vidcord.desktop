[Desktop Entry]
Name=Vidcord
Exec=vidcord %f
Icon=icon
Type=Application
Categories=AudioVideo;
Comment=Video Compressor and Converter
Terminal=false
MimeType=video/mp4;video/x-msvideo;video/quicktime;video/x-matroska;video/x-flv;video/x-ms-wmv;video/webm;
Actions=Compress;

[Desktop Action Compress]
Name=Compress with Vidcord
Exec=vidcord %f
