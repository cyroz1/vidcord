# Maintainer: Your Name <your.email@example.com>
pkgname=vidcord
pkgver=5.0
pkgrel=1
pkgdesc="A video compressor using ffmpeg and PyQt5"
arch=('x86_64')
url="https://github.com/cyroz1/vidcord"
license=('MIT')
depends=('python' 'ffmpeg' 'python-pyqt5' 'tk') # tk might be needed for some python deps, adjusted based on imports
makedepends=('python-pip' 'git')
source=("git+https://github.com/cyroz1/vidcord.git")
md5sums=('SKIP')

# Note: This PKGBUILD assumes building from source using the system python environment 
# OR packaging the pyinstaller binary. 
# Here we package the PyInstaller binary generated from the local source for simplicity of the user request context,
# but traditionally Arch packages build from source. 
# WE WILL ASSUME THE USER HAS BUILT THE BINARY USING linux/build.sh AND WE ARE PACKAGING THAT.

package() {
    # If packaging the binary built by linux/build.sh
    # Assuming the user runs makepkg in linux/arch and the dist folder is at ../../dist
    
    cd "$srcdir/../../dist" || return 1
    
    install -dm755 "$pkgdir/opt/$pkgname"
    cp -r vidcord "$pkgdir/opt/$pkgname/"
    
    install -dm755 "$pkgdir/usr/bin"
    ln -s "/opt/$pkgname/vidcord" "$pkgdir/usr/bin/$pkgname"
    
    # Install icon and desktop file if we had them ready-to-go
    # install -Dm644 "$srcdir/../../icon.png" "$pkgdir/usr/share/pixmaps/$pkgname.png"
    # echo "[Desktop Entry]
    # Type=Application
    # Version=1.0
    # Name=VidCord
    # Comment=Video Compressor
    # Exec=vidcord
    # Icon=vidcord
    # Terminal=false
    # Categories=AudioVideo;Video;" > "$pkgdir/usr/share/applications/$pkgname.desktop"
}
