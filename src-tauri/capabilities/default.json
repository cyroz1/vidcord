{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for vidcord desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "dialog:default",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
